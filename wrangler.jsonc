{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rajab-alaboud-site-cloudflare",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // D1 binding removed temporarily to allow deployment without a configured
  // D1 database. If you have a D1 database, replace this comment with the
  // d1_databases array and set "database_id" to your database's ID.
  "vars": {
    "SITE_URL": "https://rajab-alaboud-site-cloudflare.workers.dev",
    "NOTIFICATION_EMAIL": "rajabalaboud@gmail.com",
    "ALLOW_DEMO_SUBMISSIONS": "false"
  }
}
