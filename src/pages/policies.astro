---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPublicContent } from '../lib/server-content';
const { policies } = await getPublicContent();
const order = ['privacy','disclaimer'];
const sorted = [...policies].sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
---
<BaseLayout title="السياسات والشروط" description="سياسات الخصوصية والطلب والتوصيل والاستبدال والاسترجاع وإخلاء المسؤولية.">
  <PageHeader title="السياسات والشروط" eyebrow="مرجع واحد واضح" description="جُمعت السياسات في صفحة واحدة لتسهيل الوصول إليها. هذه النصوص تشغيلية أولية ولا تمثل استشارة قانونية نهائية." />
  <section class="section-tight"><div class="container"><nav class="policy-index card" aria-label="فهرس السياسات">{sorted.map((policy) => <a href={`#${policy.slug}`}>{policy.title}</a>)}</nav></div></section>
  <section class="section"><div class="container policy-layout">{sorted.map((policy) => <article class="card policy-section" id={policy.slug}><p class="eyebrow">آخر تحديث: {policy.updated}</p><h2>{policy.title}</h2><p class="lead">{policy.description}</p>{policy.alert && <div class="notice notice-info">{policy.alert}</div>}<div class="policy-content">{policy.sections.map((section) => <section><h3>{section.heading}</h3><p>{section.body}</p></section>)}</div><a class="text-link" href="#main-content">العودة إلى أعلى الصفحة ↑</a></article>)}</div></section>
</BaseLayout>
