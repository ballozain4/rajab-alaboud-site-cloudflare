---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
}
const { id, eyebrow = '', title, description = '' } = Astro.props;
---
<div class="builder-heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {description && <p class="lead">{description}</p>}
</div>
