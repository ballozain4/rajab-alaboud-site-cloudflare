---
interface Props {
  name?: string;
  size?: number;
  strokeWidth?: number;
  title?: string;
}

const { name = 'sparkles', size = 24, strokeWidth = 1.8, title } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  {name === 'sparkles' && <><path d="m12 3 1.15 3.1L16 7.5l-2.85 1.4L12 12l-1.15-3.1L8 7.5l2.85-1.4L12 3Z"/><path d="m18 13 .8 2.2L21 16l-2.2.8L18 19l-.8-2.2L15 16l2.2-.8L18 13Z"/><path d="m6 14 .8 2.2L9 17l-2.2.8L6 20l-.8-2.2L3 17l2.2-.8L6 14Z"/></>}
  {name === 'leaf' && <><path d="M20.8 3.2C13 3.5 6.2 5.7 5 12.2c-.8 4.2 2.4 6.8 5.7 6.4 6.6-.8 9.1-8.2 10.1-15.4Z"/><path d="M4 21c2.8-6.2 7.1-9.4 13.2-12"/></>}
  {name === 'droplet' && <path d="M12 2.7S5.5 9.4 5.5 14.7a6.5 6.5 0 0 0 13 0C18.5 9.4 12 2.7 12 2.7Z"/>}
  {name === 'message' && <><path d="M21 11.4a8 8 0 0 1-8.5 8 9.1 9.1 0 0 1-3.8-.9L3 20l1.5-5.3a8 8 0 1 1 16.5-3.3Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/></>}
  {name === 'whatsapp' && <><path d="M21 11.5a8.5 8.5 0 0 1-12.7 7.4L3 20l1.2-5A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.1 7.8c.4 3.8 2.4 5.8 6.2 6.3l1.2-1.3"/></>}
  {name === 'gallery' && <><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m21 15-5-5L5 20"/></>}
  {name === 'user' && <><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></>}
  {name === 'award' && <><circle cx="12" cy="8" r="5"/><path d="m8.6 12-1.4 9 4.8-3 4.8 3-1.4-9"/></>}
  {name === 'phone' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2Z"/>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r=".8" fill="currentColor" stroke="none"/></>}
  {name === 'facebook' && <path d="M14 21v-8h3l.5-3H14V8.2c0-.9.3-1.7 1.8-1.7H18V3.8c-.7-.1-1.5-.2-2.3-.2-2.3 0-4.7 1.4-4.7 4.8V10H8v3h3v8"/>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16"/></>}
  {name === 'close' && <><path d="m6 6 12 12M18 6 6 18"/></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'trash' && <><path d="M3 6h18M8 6V4h8v2M7 6l1 15h8l1-15M10 10v7M14 10v7"/></>}
  {name === 'arrow' && <><path d="M19 12H5M12 19l-7-7 7-7"/></>}
</svg>
